# Copia este archivo a .env (en la raíz del repo) y ajusta los valores.
# .env está en .gitignore: nunca subas credenciales al repositorio.

# --- Django ---
DEBUG=True
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
# Hosts extra separados por comas (Render agrega RENDER_EXTERNAL_HOSTNAME solo).
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=

# --- Base de datos ---
# Vacío = SQLite local (bakeandmade/db.sqlite3).
# PostgreSQL: postgresql://usuario:clave@host:5432/basededatos
DATABASE_URL=

# --- AWS S3 para imágenes subidas (opcional en local) ---
# Si AWS_STORAGE_BUCKET_NAME está vacío, las imágenes se guardan en bakeandmade/media/.
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_CUSTOM_DOMAIN=

# --- Superusuario creado por build.sh (opcional) ---
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
